@model List<ApplicationUser>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />
<h3 class="text-warning">@TempData["save"]</h3>
<div class="row">
    <div class="col-6">
        <h2>System Users </h2>
    </div>

    <div class="col-6 text-end">
        <a class="btn btn-info" asp-action="Create"><i class="fa-solid fa-plus"></i> new User</a>
    </div>
</div>

<br />

<div>
    <table class="table table-striped table-hover border">
        <tr class="table-info">
            <th>User Name</th>
            <th>Email</th>
            <th>Full Name</th>
            <th>Status</th>
            <th> </th>
        </tr>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.UserName</td>
                <td>@u.Email</td>
                <td>@u.FullName</td>
                @if (u.LockoutEnd > DateTime.Now && u.LockoutEnd != null)
                {
                    <td>Inactive</td>

                    <td>
                    <td style="width:150px">
                        <div class="btn-group">
                            @* <a asp-action="Active" class="btn btn-primary" asp-route-id="@u.Id"><i class="fa-solid fa-pen-to-square"></i></a> *@
                            <a asp-action="Active" class="btn btn-warning" asp-route-id="@u.Id">Active</a>
                            <a asp-action="Delete" class="btn btn-danger" asp-route-id="@u.Id"><i class="fa-solid fa-trash"></i></a>

                        </div>
                    </td>
                    </td>
                }
                else
                {
                    <td>Active</td>
                    <td>
                    <td style="width:150px">
                        <div class="btn-group">
                            <a asp-action="Edit" class="btn btn-primary" asp-route-id="@u.Id"><i class="fa-solid fa-pen-to-square"></i></a>
                            <a asp-action="Lockout" class="btn btn-danger" asp-route-id="@u.Id"><i class="fa-solid fa-lock"></i></a>
                            <a asp-action="Details" class="btn btn-success" asp-route-id="@u.Id"><i class="fa-solid fa-circle-info"></i></a>
                        </div>
                    </td>
                    </td>
                }
            </tr>

        }
    </table>
</div>

