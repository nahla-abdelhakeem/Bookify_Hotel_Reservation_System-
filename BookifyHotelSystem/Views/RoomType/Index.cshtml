@model List<RoomType>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />
<h3 class="text-warning">@TempData["save"]</h3>
<div class="row">
    <div class="col-6">
        <h2>Room type list</h2>
    </div>

    <div class="col-6 text-end">
        <a class="btn btn-info" asp-action="Create"><i class="fa-solid fa-plus"></i> new product type</a>
    </div>
</div>

<br />

<div>
    <table class="table table-striped table-hover border">
        <tr class="table-info">
            <th>Product Type</th>
            <th> </th>
            <th> </th>
        </tr>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.TypeName</td>
                
                    <td>
                        <td style="width:150px">
                        <div class="btn-group">
                            <a asp-action="Edit" class="btn btn-primary" asp-route-id="@r.Id"><i class="fa-solid fa-pen-to-square"></i></a>
                            <a asp-action="Delete" class="btn btn-danger" asp-route-id="@r.Id"><i class="fa-solid fa-trash"></i></a>
                            <a asp-action="Details" class="btn btn-success" asp-route-id="@r.Id"><i class="fa-solid fa-circle-info"></i></a>
                        </div>
                    </td>
                    </td>
               
            </tr>

        }
    </table>
</div>