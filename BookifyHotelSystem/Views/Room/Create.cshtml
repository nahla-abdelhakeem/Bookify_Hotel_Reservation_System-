@model Room
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />

<h2>Add Room</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div class="p-4 rounded border">
        <div asp-validation-summary="All" class="text-danger">
        </div>
        <h3 class="text-danger">@ViewBag.message</h3>
        <div class="form-group row">
            <div class="col-2">
                <label asp-for="Name"></label>
            </div>
            <div class="col-5">
                <input asp-for="Name" class="form-control" />
            </div>
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <br />
        <div class="form-group row">
            <div class="col-2">
                <label asp-for="PricePerNight"></label>
            </div>
            <div class="col-5">
                <input asp-for="PricePerNight" class="form-control" />
            </div>
            <span asp-validation-for="PricePerNight" class="text-danger"></span>
        </div>
        <br />
        <div class="form-group row">
            <div class="col-2">
                <label asp-for="ImageFile"></label>
            </div>
            <div class="col-5">
                <input asp-for="ImageFile" class="form-control" type="file" />
            </div>
            <span asp-validation-for="ImageFile" class="text-danger"></span>
        </div>
        <br />
        <br />
        <div class="form-group row">
            <div class="col-2">
                <label asp-for="RoomTypeId"></label>
            </div>
            <div class="col-5">
                <select class="form-control" asp-for="RoomTypeId" asp-items="@ViewBag.RoomTypes">
                </select>
            </div>
            <span asp-validation-for="RoomTypeId" class="text-danger"></span>
        </div>
        <br />
        <div class="form-group row">
            <div class="col-2">
                <label asp-for="IsAvailable"></label>
            </div>
            <div class="col-5">
                <input asp-for="IsAvailable" type="checkbox" />
            </div>
            <span asp-validation-for="IsAvailable" class="text-danger"></span>
        </div>
        <br />
        <div class="">
            <input type="submit" class="btn btn-primary" value="Save" />
            <a asp-action="Index" class="btn btn-success">Back To List</a>
        </div>
    </div>
</form>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}