<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Dashboard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin-dashboard.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="admin-wrapper">
        <!-- Sidebar -->
        <aside class="admin-sidebar">
            <div class="sidebar-header">
                <i class="fas fa-hotel"></i>
                <h3>Bookify Admin</h3>
            </div>

            <nav class="sidebar-nav">
                <a asp-controller="Admin" asp-action="Dashboard" class="nav-item">
                    <i class="fas fa-chart-line"></i>
                    <span>Dashboard</span>
                </a>

                <a asp-controller="User" asp-action="Index" class="nav-item">
                    <i class="fas fa-users"></i>
                    <span>Users</span>
                </a>

                <a asp-controller="Role" asp-action="Index" class="nav-item">
                    <i class="fas fa-user-shield"></i>
                    <span>Roles</span>
                </a>

                <a asp-controller="Role" asp-action="Assign" class="nav-item">
                    <i class="fas fa-user-cog"></i>
                    <span>Assign Roles</span>
                </a>

                <a asp-controller="RoomType" asp-action="Index" class="nav-item">
                    <i class="fas fa-bed"></i>
                    <span>Room Types</span>
                </a>

                <a asp-controller="Room" asp-action="Index" class="nav-item">
                    <i class="fas fa-door-open"></i>
                    <span>Rooms</span>
                </a>

                <a asp-controller="Booking" asp-action="Index" class="nav-item">
                    <i class="fas fa-calendar-check"></i>
                    <span>Bookings</span>
                </a>

                <div class="sidebar-divider"></div>

                <a asp-controller="Home" asp-action="Index" class="nav-item">
                    <i class="fas fa-globe"></i>
                    <span>View Website</span>
                </a>

                <a asp-controller="Account" asp-action="Logout" class="nav-item">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Logout</span>
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <div class="admin-content">
            <!-- Top Navbar -->
            <header class="admin-header">
                <div class="header-left">
                    <button class="sidebar-toggle" id="sidebarToggle">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h1 class="page-title">@ViewData["Title"]</h1>
                </div>

                <div class="header-right">
                    <div class="admin-user">
                        <img src="/Images/avatar.png" alt="Admin" class="admin-avatar">
                        <span class="admin-name">@User.Identity.Name</span>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="admin-main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin-dashboard.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>